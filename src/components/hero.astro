---
interface Props {
    author: {
        name: string;
        title: string;
    };
    heading: string;
    subheading: string;
}

const { author, heading, subheading } = Astro.props;
---

<section id="hero-content" aria-labelledby="hero-heading" class="relative">
    <div
        aria-hidden="true"
        class="pointer-events-none absolute top-1/2 right-4 z-[1] -translate-y-1/2 select-none [mask-image:radial-gradient(ellipse_75%_75%_at_65%_50%,black_20%,rgba(0,0,0,0.8)_58%,transparent_88%)] md:right-10"
    >
        <canvas
            data-hero-bitmap
            class="block aspect-[13/10] w-[clamp(14.5rem,33vw,30rem)]"
        ></canvas>
        <noscript>
            <div class="font-serif text-[clamp(11rem,25vw,23rem)] leading-none tracking-[-0.03em] text-zinc-950/[0.15] dark:text-zinc-50/[0.12]">
                Aa
            </div>
        </noscript>
    </div>

    <div class="relative z-10 space-y-5">
        <div>
            <p class="text-xs word-spacing-wide leading-relaxed text-neutral-500">
                Written by{" "}
                <span class="text-journal-accent-text">{author.name}</span>
                <span class="hidden md:inline"> · {author.title}</span>
            </p>
        </div>

        <div>
            <h1
                id="hero-heading"
                class="max-w-2xl text-5xl leading-[1.15] font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50"
            >
                {heading}
            </h1>
        </div>

        <div>
            <p class="max-w-3xl text-base leading-relaxed text-neutral-500 md:text-lg">
                {subheading}
            </p>
        </div>
    </div>
</section>

<script>
    import { renderGlyphBitmap } from "../scripts/bitmap";

    const canvas =
        document.querySelector<HTMLCanvasElement>("[data-hero-bitmap]");

    if (canvas) {
        const root = document.documentElement;
        const fontFamily =
            getComputedStyle(root)
                .getPropertyValue("--font-source-serif-4")
                .trim() || "serif";

        const draw = () =>
            renderGlyphBitmap(canvas, {
                text: "Aa",
                size: 1,
                color: getComputedStyle(root)
                    .getPropertyValue("--bitmap-glyph")
                    .trim(),
                font: (px) => `400 ${px}px ${fontFamily}, Georgia, serif`,
            });

        draw();
        document.fonts.load(`400 100px ${fontFamily}`).then(draw, draw);

        let resizeTimer: number | undefined;
        window.addEventListener("resize", () => {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(draw, 150);
        });

        new MutationObserver(draw).observe(root, {
            attributes: true,
            attributeFilter: ["data-theme"],
        });
    }
</script>
