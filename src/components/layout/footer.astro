---
import FooterMascot from "@/components/layout/footer-mascot.astro";

interface Props {
    title: string;
    social: { name: string; href: string }[];
    description: string;
    copyright: string;
}

const { title, social, description, copyright } = Astro.props;

const socialLinkClass =
    "transition-colors duration-150 hover:text-journal-accent-text motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-journal-accent";
---

<hr class="border-smooth-border" />

<footer class="mx-auto w-full max-w-6xl px-5 sm:px-6">
    <div class="relative py-16">
        <section class="relative z-10 flex flex-col gap-8 md:flex-row md:items-center md:justify-between md:gap-12">
            <div class="flex flex-col">
                <a
                    href="/"
                    class="flex w-fit items-center text-sm font-bold tracking-tight transition-colors hover:text-journal-accent-text focus-visible:text-journal-accent-text"
                >
                    {title}
                </a>

                <p class="mt-3 max-w-xs text-sm text-neutral-500">
                    {description}
                </p>
            </div>
        </section>

        <FooterMascot class="pointer-events-none absolute right-0 bottom-0 h-full w-[45%] md:w-[55%] xl:w-[62%]" />
    </div>

    <section class="flex flex-col gap-4 border-t border-smooth-border py-8 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
        <span>
            © {new Date().getFullYear()} {copyright}
        </span>
        <ul class="flex items-center gap-4">
            {social.map(({ name, href }) => (
                <li>
                    <a
                        href={href}
                        target={href.startsWith("http") ? "_blank" : undefined}
                        rel={
                            href.startsWith("http")
                                ? "noopener noreferrer"
                                : undefined
                        }
                        class={socialLinkClass}
                    >
                        {name}
                    </a>
                </li>
            ))}
        </ul>
    </section>
</footer>
