---
import { brandIcon, icon } from "./icons";

interface Props {
    showcase: {
        slug: string;
        title: string;
        description: string;
        category: string;
        thumbnail: string;
        is_archive: boolean;
        link?: {
            repository?: string;
            preview?: string;
        };
    };
    headingLevel?: 2 | 3;
}

const { showcase: data, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";

const external = data.link?.repository
    ? {
          href: data.link.repository,
          label: "Repository",
          icon: brandIcon("github", "size-4 shrink-0"),
      }
    : data.link?.preview
      ? {
            href: data.link.preview,
            label: "Live demo",
            icon: icon("arrow-up-right", "size-4 shrink-0"),
        }
      : null;
---

<article class="group flex h-full flex-col overflow-hidden rounded-lg border border-smooth-border bg-surface transition-colors duration-100 hover:border-journal-accent/60">
    <div class="relative aspect-[16/10] overflow-hidden border-b border-smooth-border bg-neutral-100">
        <img
            src={data.thumbnail}
            alt=""
            width="1200"
            height="750"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover"
        />

        {data.is_archive && (
            <span class="absolute top-2.5 left-2.5 rounded-full border border-warning-border bg-warning-bg px-2 py-0.5 text-[0.6875rem] font-medium text-warning-text shadow-sm">
                unmaintained
            </span>
        )}
    </div>

    <div class="relative flex flex-1 flex-col">
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
        >
            <div class="bitmap-glow absolute -top-12 -right-12 size-40 opacity-0 transition-opacity duration-150 group-hover:opacity-55 motion-reduce:transition-none dark:group-hover:opacity-45"></div>
        </div>

        <div class="relative flex flex-1 flex-col gap-3 p-4.5">
            <p class="text-xs word-spacing-wide font-medium text-journal-accent-text">
                {data.category}
            </p>

            <Heading class="text-base leading-snug font-bold text-zinc-950 dark:text-zinc-50">
                <a
                    href={`/showcase/${data.slug}/`}
                    class="transition-colors duration-100 hover:text-journal-accent-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent"
                >
                    {data.title}
                </a>
            </Heading>

            <p class="line-clamp-3 text-[0.8125rem] leading-relaxed text-zinc-600 dark:text-zinc-400">
                {data.description}
            </p>

            <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-smooth-border pt-3 text-xs word-spacing-wide font-medium">
                {external && (
                    <a
                        href={external.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-8 items-center gap-1.5 text-neutral-600 transition-colors duration-100 hover:text-journal-accent-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent"
                    >
                        <Fragment set:html={external.icon} />
                        {external.label}
                    </a>
                )}

                <a
                    href={`/showcase/${data.slug}/`}
                    aria-label={`Read more about ${data.title}`}
                    class="ml-auto inline-flex min-h-8 items-center text-zinc-950 underline decoration-neutral-300 underline-offset-4 transition-colors duration-100 hover:text-journal-accent-text hover:decoration-journal-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent dark:text-zinc-50"
                >
                    read more
                </a>
            </div>
        </div>
    </div>
</article>
