---
import "../styles/global.css";

import { config } from "../config";
import { NAV_ITEMS } from "../navigation";
import { ogImagePath } from "../og/paths";
import {
    articleStructuredData,
    homeStructuredData,
    serializeStructuredData,
    type ArticleMeta,
} from "../seo/structured-data";
import { toIsoDate } from "../utils/date";
import { truncate } from "../utils/text";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar.astro";
import Sidebar from "../components/sidebar.astro";

interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
    article?: Omit<ArticleMeta, "published"> & { date: string };
}

const {
    title,
    description = config.description,
    noindex = false,
    article,
} = Astro.props;

const documentTitle = title
    ? `${title} · ${config.title}`
    : `${config.title} — ${config.ui.home.hero.heading}`;
const socialTitle = title ?? documentTitle;
const metaDescription = truncate(description, 160);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath(Astro.url.pathname), Astro.site);
const published = article ? toIsoDate(article.date) : null;

const structuredData =
    article && published
        ? articleStructuredData({
              meta: { ...article, published },
              title: socialTitle,
              description,
              url: canonical.href,
              image: ogImage.href,
          })
        : Astro.url.pathname === "/"
          ? homeStructuredData(new URL("/", Astro.site).href)
          : [];
---

<!doctype html>
<html
    lang="en"
    data-theme="clean-light"
    data-scroll-behavior="smooth"
    class="scroll-smooth"
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{documentTitle}</title>
        <meta name="description" content={metaDescription} />
        {noindex ? (
            <meta name="robots" content="noindex, follow" />
        ) : (
            <link rel="canonical" href={canonical} />
        )}
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={config.title}
            href={new URL(config.rss, Astro.site)}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content={article ? "article" : "website"} />
        <meta property="og:site_name" content={config.title} />
        <meta property="og:title" content={socialTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialTitle} />
        <meta property="og:locale" content="en_US" />
        {article && published && (
            <>
                <meta property="article:published_time" content={published} />
                <meta property="article:section" content={article.section} />
                {article.tags.map((tag) => (
                    <meta property="article:tag" content={tag} />
                ))}
            </>
        )}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={socialTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={socialTitle} />

        {structuredData.length > 0 && (
            <script
                is:inline
                type="application/ld+json"
                set:html={serializeStructuredData(
                    structuredData.length === 1
                        ? structuredData[0]
                        : structuredData,
                )}
            />
        )}

        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem("theme");
                    var theme =
                        stored === "clean-light" || stored === "charcoal"
                            ? stored
                            : "clean-light";
                    document.documentElement.setAttribute("data-theme", theme);
                } catch (e) {}
            })();
        </script>
    </head>
    <body class="min-h-screen overflow-x-hidden bg-background font-sans text-foreground antialiased transition-colors duration-200 selection:bg-journal-accent/25">
        <a
            href="#main-content"
            class="fixed left-4 top-4 z-[100] -translate-y-20 rounded-md border border-smooth-border bg-surface px-4 py-2 font-mono text-xs text-journal-accent-text shadow-lg transition-transform duration-150 focus-visible:translate-y-0"
        >
            Skip to content
        </a>

        <Sidebar items={NAV_ITEMS} />

        <div id="app">
            <Navbar title={config.title} items={NAV_ITEMS} />

            <slot />

            <Footer
                title={config.title}
                social={[
                    ...config.author.social,
                    { name: "Email", href: `mailto:${config.author.email}` },
                    { name: "RSS", href: config.rss },
                ]}
                description={config.ui.footer.description}
                copyright={config.author.name}
            />
        </div>
        <script is:inline>
            document
                .getElementById("theme-toggle")
                ?.setAttribute(
                    "aria-pressed",
                    String(
                        document.documentElement.getAttribute("data-theme") ===
                            "charcoal",
                    ),
                );
        </script>
        <script src="../scripts/ui.ts"></script>
    </body>
</html>
