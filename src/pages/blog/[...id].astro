---
import { getCollection } from "astro:content";
import ArticlePage from "@/components/article/article-page.astro";

export async function getStaticPaths() {
    const writeups = await getCollection("writeups");

    return writeups.map((entry) => ({
        params: { id: entry.data.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
---

<ArticlePage
    entry={entry}
    basePath="/blog/"
    meta={{
        kind: "BlogPosting",
        section: "Writeups",
        tags: [data.tag],
    }}
    header={{
        idTitle: "article-title",
        tagline: data.tag,
        reading_time: data.reading_time,
        sharePosition: "right",
    }}
/>
