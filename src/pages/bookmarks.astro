---
import MainLayout from "../layouts/main-layout.astro";
import { icon } from "../components/icons";
import { config } from "../config";

const { heading, description } = config.ui.pages.bookmarks;
---

<MainLayout title={heading} description={description}>
    <main
        id="main-content"
        class="m-auto w-full max-w-6xl px-5 pt-0 pb-16 sm:px-6 md:pb-24"
    >
        <h1 class="sr-only">{heading}</h1>

        <div class="sticky top-16 z-40 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-smooth-border bg-background/80 py-2 backdrop-blur-md">
            <p class="text-xs word-spacing-wide font-medium text-zinc-950 dark:text-zinc-50">
                {heading}{" "}
                <span data-bookmark-count class="opacity-60">
                    0
                </span>
            </p>

            <div class="flex w-full shrink-0 items-center gap-2 sm:w-auto">
                <div class="w-full sm:w-64">
                    <div class="flex items-center gap-2 rounded-full border border-smooth-border bg-neutral-100/60 py-1.5 pr-1.5 pl-3 transition-colors duration-150 hover:border-neutral-400/60 focus-within:border-journal-accent/60 motion-reduce:transition-none">
                        <Fragment
                            set:html={icon(
                                "search",
                                "size-3.5 shrink-0 text-neutral-500",
                            )}
                        />

                        <input
                            type="search"
                            placeholder="search bookmarks..."
                            aria-label="Search bookmarks"
                            autocomplete="off"
                            data-bookmarks-search
                            class="w-full min-w-0 bg-transparent text-xs word-spacing-wide font-medium text-zinc-950 outline-none placeholder:text-neutral-500 [&::-webkit-search-cancel-button]:hidden dark:text-zinc-50"
                        />

                        <button
                            type="button"
                            aria-label="Clear search"
                            data-clear-search
                            hidden
                            class="-my-0.5 shrink-0 cursor-pointer rounded-full p-1 text-neutral-500 transition-colors duration-100 hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-journal-accent dark:hover:text-zinc-50"
                        >
                            <Fragment set:html={icon("x", "size-3")} />
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <section aria-label="Bookmarked articles" class="mt-8">
            <div
                data-bookmark-list
                class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
            ></div>

            <p data-empty-message class="text-sm text-neutral-500">
                No bookmarks yet. Open any article on this site and hit the
                bookmark icon to save it here.
            </p>
        </section>
    </main>

    <script src="../scripts/bookmarks.ts"></script>
</MainLayout>
