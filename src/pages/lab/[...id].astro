---
import { getCollection } from "astro:content";
import ArticlePage from "@/components/article/article-page.astro";
import { estimateReadingTime } from "@/lib/utils/markdown";

export async function getStaticPaths() {
    const experiments = await getCollection("laboratory");

    return experiments.map((entry) => ({
        params: { id: entry.data.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
---

<ArticlePage
    entry={entry}
    basePath="/lab/"
    isArchive={data.is_archive}
    meta={{
        kind: "Article",
        section: "Laboratory",
        tags: [data.category, ...data.stack],
    }}
    header={{
        idTitle: "experiment-title",
        tagline: data.category,
        reading_time: estimateReadingTime(entry.body ?? ""),
        links: data.links,
        archiveNotice: data.is_archive
            ? "This experiment has been archived and is no longer maintained. Some information or links may be outdated."
            : undefined,
    }}
/>
