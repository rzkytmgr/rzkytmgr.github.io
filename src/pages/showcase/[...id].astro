---
import { getCollection } from "astro:content";
import ArticlePage from "@/components/article/article-page.astro";
import { estimateReadingTime } from "@/lib/utils/markdown";

export async function getStaticPaths() {
    const showcases = await getCollection("showcase");

    return showcases.map((entry) => ({
        params: { id: entry.data.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const data = entry.data;
---

<ArticlePage
    entry={entry}
    basePath="/showcase/"
    isArchive={data.is_archive}
    alwaysShowAside
    meta={{
        kind: "Article",
        section: "Showcase",
        tags: [data.category, ...data.tech_stack],
    }}
    header={{
        idTitle: "project-title",
        tagline: data.category,
        reading_time: estimateReadingTime(entry.body ?? ""),
        repository: data.link?.repository,
        preview: data.link?.preview,
        archiveNotice: data.is_archive
            ? "This project is no longer maintained. Some information or links may be outdated."
            : undefined,
    }}
/>
